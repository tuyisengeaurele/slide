---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Set PUBLIC_CONTACT_EMAIL at build time and the form below sends there.
const email = import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined;
---

<Base
  title="Request early access"
  description="Tell us about your phone team and how your calls work today. We're piloting Slide in Rwanda and talking to teams in other countries too."
>
  <PageHero
    kicker="Early access"
    title="Tell us about"
    soft="your team."
    lede="We're piloting Slide in Rwanda and talking to teams in other countries too. Tell us how your calls work today and we'll be in touch."
  />

  <section class="section">
    <div class="container wrap">
      <form class="form reveal" data-email={email ?? ''}>
        <div class="two">
          <label>
            <span>Your name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Work email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
        </div>
        <div class="two">
          <label>
            <span>Organisation</span>
            <input name="organisation" autocomplete="organization" required />
          </label>
          <label>
            <span>Country</span>
            <input name="country" autocomplete="country-name" required />
          </label>
        </div>
        <label>
          <span>How many people answer calls?</span>
          <select name="size" required>
            <option value="" disabled selected>
              Choose one
            </option>
            <option>1 to 10</option>
            <option>11 to 50</option>
            <option>51 to 200</option>
            <option>More than 200</option>
          </select>
        </label>
        <label>
          <span>How do you take calls today?</span>
          <textarea
            name="message"
            rows="4"
            placeholder="Desk phones, personal phones, a spreadsheet, something else?"
            required
          ></textarea>
        </label>
        <button class="btn btn-primary" type="submit">
          Send request
        </button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="side reveal">
        <h2>What happens next</h2>
        <ol>
          <li>We read your note.</li>
          <li>We reach out to hear how your calls work today.</li>
          <li>If Slide fits, we talk about joining the pilot.</li>
        </ol>
        {email ? (
          <p>
            Prefer email? Write to <a href={`mailto:${email}`}>{email}</a>.
          </p>
        ) : (
          <p>The shared inbox opens with the launch. Until then, this form is the way in.</p>
        )}
      </aside>
    </div>
  </section>
</Base>

<style>
  .wrap {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  label {
    display: grid;
    gap: 8px;
  }
  label span {
    font-size: 0.875rem;
    font-weight: 550;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 13px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--orange);
    box-shadow: 0 0 0 4px var(--orange-soft);
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  .form .btn {
    justify-self: start;
  }
  .status {
    min-height: 1.5em;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .side h2 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .side p {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .side ol {
    margin: 16px 0 0;
    padding-left: 1.25rem;
    color: var(--ink-2);
    display: grid;
    gap: 8px;
  }
  .side a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-email]');
  const status = form?.querySelector<HTMLElement>('.status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const to = form.dataset.email;
    const data = new FormData(form);

    if (!to) {
      // better to say nothing was sent than to pretend it was
      if (status) {
        status.textContent =
          "This form isn't connected yet, so nothing was sent. Please check back soon.";
      }
      return;
    }

    const subject = encodeURIComponent(`Early access request from ${data.get('organisation')}`);
    const body = encodeURIComponent(
      [
        `Organisation: ${data.get('organisation')}`,
        `Country: ${data.get('country')}`,
        `People answering calls: ${data.get('size')}`,
        '',
        String(data.get('message')),
        '',
        String(data.get('name')),
        String(data.get('email')),
      ].join('\n'),
    );
    location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    if (status) status.textContent = 'Opening your email app.';
  });
</script>

---
import icon from '@slide/ui/brand/slide-icon.svg?url';
---

<!--
  A fake agent workspace, built from HTML so it stays sharp and weighs next to nothing.
  One 14s loop: it rings, the agent picks up, the caller's history shows, the call gets wrapped.
  All names and numbers are made up, the "Sample data" tag says so.
-->
<div class="stage" data-stage>
  <p class="sr-only">
    A look at the agent workspace. An inbound call rings, the agent answers, the caller's history
    appears beside the call, then the call is wrapped up and saved.
  </p>

  <div class="frame" aria-hidden="true">
    <div class="float a" aria-hidden="true">
      <i></i>Recording on, consent played
    </div>
    <div class="float b" aria-hidden="true">
      <i></i>Routed to Billing in 0:02
    </div>
    <div class="bar">
      <i></i>
      <i></i>
      <i></i>
      <b>Agent workspace</b>
      <em>Sample data</em>
    </div>

    <div class="app">
      <nav class="rail">
        <img src={icon} alt="" width="26" height="31" />
        <span class="on">
          <svg viewBox="0 0 24 24">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
          </svg>
        </span>
        <span>
          <svg viewBox="0 0 24 24">
            <circle cx="9" cy="8" r="3.2"></circle>
            <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5a3.2 3.2 0 0 1 0 6M18 14c1.9.7 3 2.5 3 4.6"></path>
          </svg>
        </span>
        <span>
          <svg viewBox="0 0 24 24">
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>
          </svg>
        </span>
        <span>
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"></path>
          </svg>
        </span>
      </nav>

      <section class="list">
        <div class="h">
          Inbound <small>4 waiting</small>
        </div>
        <div class="row hot">
          <div class="av">DO</div>
          <div class="t">
            <b>Daniel Okafor</b>
            <span>Billing, invoice question</span>
          </div>
          <time>0:09</time>
        </div>
        <div class="row">
          <div class="av">MR</div>
          <div class="t">
            <b>Maya Reyes</b>
            <span>Order status</span>
          </div>
          <time>0:41</time>
        </div>
        <div class="row">
          <div class="av">TL</div>
          <div class="t">
            <b>Tomas Lind</b>
            <span>Cancel subscription</span>
          </div>
          <time>1:12</time>
        </div>
        <div class="row">
          <div class="av">PS</div>
          <div class="t">
            <b>Priya Shah</b>
            <span>Setup help</span>
          </div>
          <time>1:30</time>
        </div>
      </section>

      <section class="call">
        <div class="who">
          <div class="av">DO</div>
          <div>
            <h3>Daniel Okafor</h3>
            <p>+1 (555) 014-2290 · Billing</p>
          </div>
          <div class="status clock">
            <div class="layers">
              <div class="s-ring">
                <b>Ringing</b>
                <span>Inbound</span>
              </div>
              <div class="s-live">
                <b></b>
                <span>Connected</span>
              </div>
              <div class="s-wrap">
                <b>Wrap-up</b>
                <span>Call ended</span>
              </div>
            </div>
          </div>
        </div>

        <div class="layers">
          <div class="ring s-ring">
            <div class="ring-in">
              <div class="pulse">
                <span class="dot">
                  <svg viewBox="0 0 24 24">
                    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
                  </svg>
                </span>
              </div>
              <p>Daniel is waiting</p>
            </div>
          </div>
          <div class="wave s-live">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="wrap s-wrap">
            <p>How did it go?</p>
            <div class="chips">
              <span class="chip">Follow up</span>
              <span class="chip pick">Resolved</span>
              <span class="chip">Escalate</span>
            </div>
          </div>
        </div>

        <div class="ctrls">
          <div class="answer s-ring">
            <span class="go">
              <svg viewBox="0 0 24 24">
                <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
              </svg>
              Answer
            </span>
          </div>
          <div class="live s-live">
            <span class="ctl">
              <svg viewBox="0 0 24 24">
                <rect x="9" y="3" width="6" height="11" rx="3"></rect>
                <path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path>
              </svg>
            </span>
            <span class="ctl">
              <svg viewBox="0 0 24 24">
                <path d="M9 5v14M15 5v14"></path>
              </svg>
            </span>
            <span class="ctl">
              <svg viewBox="0 0 24 24">
                <path d="M4 12h14M13 6l6 6-6 6"></path>
              </svg>
            </span>
            <span class="ctl end">End call</span>
          </div>
        </div>
        <div class="toast">
          <svg viewBox="0 0 24 24">
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
          </svg>
          Saved to ticket #1042, notes synced
        </div>
      </section>

      <aside class="ctx">
        <div class="card reveal first" style="--r:0s">
          <h4>Customer</h4>
          <div class="kv">
            <span>Plan</span>
            <b>Pro, annual</b>
          </div>
          <div class="kv">
            <span>Customer since</span>
            <b>Mar 2023</b>
          </div>
          <div class="kv">
            <span>Last call</span>
            <b>3 days ago</b>
          </div>
        </div>
        <div class="card reveal" style="--r:.25s">
          <h4>Open ticket</h4>
          <div class="tick">
            <i></i>
            <div>
              #1042 Charged twice in June<small>Opened Tuesday by chat</small>
            </div>
          </div>
        </div>
        <div class="card reveal" style="--r:.5s">
          <h4>Notes</h4>
          <div class="note"></div>
          <div class="note"></div>
          <div class="note"></div>
        </div>
      </aside>
    </div>
  </div>

  <button class="pause" type="button" aria-pressed="false" data-pause>
    Pause animation
  </button>
</div>

<style>
  .stage {
    max-width: 1180px;
    margin: 56px auto 0;
    perspective: 1800px;
    position: relative;
    text-align: center;
  }
  .frame {
    position: relative;
    border-radius: 20px;
    background: var(--surface);
    text-align: left;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-frame);
    transform-origin: 50% 0;
  }
  .bar {
    height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
  }
  .bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .bar b {
    margin-left: 12px;
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  .bar em {
    margin-left: auto;
    font-style: normal;
    font-size: 0.72rem;
    color: var(--ink-3);
    border: 1px dashed var(--line-strong);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .app {
    display: grid;
    grid-template-columns: 64px 280px 1fr 300px;
    height: 520px;
  }
  .app > * {
    min-width: 0;
  }

  .rail {
    border-right: 1px solid var(--line);
    padding: 16px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: var(--surface-2);
    border-radius: 0 0 0 19px;
  }
  .rail img {
    width: 26px;
    height: auto;
    margin-bottom: 14px;
  }
  .rail span {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    color: var(--ink-3);
  }
  .rail span.on {
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--line),
      0 2px 6px rgb(27 22 18 / 0.06);
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail svg {
    width: 18px;
    height: 18px;
    stroke-width: 1.7;
  }

  .list {
    border-right: 1px solid var(--line);
    padding: 20px 14px;
    overflow: hidden;
  }
  .h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .h small {
    font-weight: 500;
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .row {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 8px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
  }
  .av {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-2);
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .row .t {
    min-width: 0;
    flex: 1;
  }
  .row .t b {
    display: block;
    font-size: 0.84rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row .t span {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row time {
    font-size: 0.75rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .row.hot {
    background: color-mix(in srgb, var(--orange) 10%, var(--surface));
    border-color: color-mix(in srgb, var(--orange) 35%, transparent);
  }
  .row.hot .av {
    background: var(--orange);
    color: var(--orange-ink);
    box-shadow: none;
  }

  .call {
    position: relative;
    padding: 28px 32px;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .who .av {
    width: 56px;
    height: 56px;
    font-size: 1.1rem;
    background: var(--orange);
    color: var(--orange-ink);
    box-shadow: 0 0 0 6px var(--orange-soft);
  }
  .who h3 {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .who p {
    margin-top: 2px;
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .status {
    margin-left: auto;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .status b {
    display: block;
    font-size: 1.625rem;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .status span {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .layers {
    display: grid;
  }
  .layers > * {
    grid-area: 1 / 1;
  }

  .wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 100%;
  }
  .wave i {
    width: 9px;
    border-radius: 9px;
    background: var(--orange);
    transform: scaleY(0.85);
    transform-origin: center;
  }
  .wave i:nth-child(1) {
    height: 36px;
  }
  .wave i:nth-child(2) {
    height: 58px;
  }
  .wave i:nth-child(3) {
    height: 88px;
  }
  .wave i:nth-child(4) {
    height: 120px;
  }
  .wave i:nth-child(5) {
    height: 76px;
  }
  .wave i:nth-child(6) {
    height: 100px;
  }
  .wave i:nth-child(7) {
    height: 52px;
  }
  .wave i:nth-child(8) {
    height: 34px;
  }
  .wave i:nth-child(odd) {
    background: color-mix(in srgb, var(--orange) 70%, #e8500f);
  }

  .ring {
    display: grid;
    place-items: center;
  }
  .ring-in {
    text-align: center;
  }
  .pulse {
    position: relative;
    width: 120px;
    height: 120px;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }
  .pulse::before,
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--orange);
    opacity: 0;
  }
  .ring p {
    margin-top: 16px;
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .dot {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--orange);
    color: var(--orange-ink);
    box-shadow: 0 12px 28px -8px rgb(252 108 38 / 0.6);
  }
  .dot svg {
    width: 26px;
    height: 26px;
    stroke-width: 1.9;
  }

  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }
  .wrap p {
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .chip {
    height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
    background: var(--surface);
  }

  .ctrls {
    position: relative;
    height: 48px;
  }
  .ctrls .live,
  .ctrls .answer {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .ctl {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink-2);
  }
  .ctl svg {
    width: 19px;
    height: 19px;
    stroke-width: 1.7;
  }
  .ctl.end {
    width: auto;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 560;
    box-shadow: none;
  }
  .go {
    height: 48px;
    padding: 0 28px;
    border-radius: var(--radius-pill);
    background: var(--orange);
    color: var(--orange-ink);
    font-weight: 600;
    font-size: 0.9375rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.35) inset,
      0 8px 24px -6px rgb(252 108 38 / 0.6);
  }
  .go svg {
    width: 17px;
    height: 17px;
    stroke-width: 2;
  }

  .toast {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 16px 10px 12px;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 12px 30px -8px rgb(0 0 0 / 0.4);
    white-space: nowrap;
  }
  .toast svg {
    width: 18px;
    height: 18px;
    stroke: var(--orange);
    stroke-width: 2.2;
  }

  .ctx {
    border-left: 1px solid var(--line);
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
    background: var(--surface-2);
    border-radius: 0 0 19px 0;
  }
  .card {
    background: var(--surface);
    border-radius: 14px;
    padding: 14px 14px 12px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .card h4 {
    margin: 0 0 10px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .kv {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    padding: 4px 0;
  }
  .kv span {
    color: var(--ink-3);
  }
  .kv b {
    font-weight: 540;
  }
  .tick {
    display: flex;
    gap: 10px;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .tick i {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--orange);
  }
  .tick small {
    display: block;
    color: var(--ink-3);
    font-size: 0.75rem;
  }
  .note {
    height: 7px;
    border-radius: 4px;
    background: var(--line-strong);
    margin: 9px 0;
  }
  .note:nth-child(3) {
    width: 82%;
  }
  .note:nth-child(4) {
    width: 64%;
  }

  .float {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 0.8125rem;
    font-weight: 500;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-strong);
    box-shadow: 0 16px 36px -12px rgb(27 22 18 / 0.3);
  }
  .float i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent);
  }
  .float.a {
    left: 56px;
    bottom: -22px;
  }
  .float.b {
    right: 56px;
    top: -22px;
  }
  .float.b i {
    background: var(--orange);
    box-shadow: 0 0 0 4px var(--orange-soft);
  }

  .pause {
    margin-top: 40px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-3);
    font-size: 0.78rem;
  }
  .pause:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  /*
    The default look is the "connected" moment, fully drawn. Motion is layered on top, so
    reduced-motion and no-JS visitors still get a complete picture.
  */
  .ring,
  .wrap,
  .ctrls .answer,
  .toast {
    opacity: 0;
    visibility: hidden;
  }
  .clock .s-live b::after {
    counter-reset: s var(--sec);
    content: '02:' counter(s, decimal-leading-zero);
  }
  .clock .s-ring,
  .clock .s-wrap {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ring,
    .wrap,
    .ctrls .answer,
    .toast,
    .clock .s-ring,
    .clock .s-wrap {
      visibility: visible;
    }

    .frame {
      opacity: 0;
      transform: rotateX(12deg) translateY(70px) scale(0.96);
      animation: settle 1.3s var(--ease-out) 0.45s forwards;
    }
    @keyframes settle {
      to {
        opacity: 1;
        transform: rotateX(0) translateY(0) scale(1);
      }
    }

    .float {
      opacity: 0;
      animation:
        rise 0.9s var(--ease-out) 1.4s forwards,
        bob 7s ease-in-out 2.4s infinite alternate;
    }
    .float.b {
      animation-delay: 1.6s, 2.6s;
    }
    @keyframes rise {
      to {
        opacity: 1;
      }
    }
    @keyframes bob {
      to {
        translate: 0 -8px;
      }
    }

    .clock .s-live b::after {
      animation: sec 14s steps(6, jump-none) infinite;
    }
    @keyframes sec {
      0%,
      22% {
        --sec: 14;
      }
      66%,
      100% {
        --sec: 20;
      }
    }

    .s-ring {
      animation: s-ring 14s infinite;
    }
    .s-live {
      animation: s-live 14s infinite;
    }
    .s-wrap {
      animation: s-wrap 14s infinite;
    }
    @keyframes s-ring {
      0%,
      17% {
        opacity: 1;
      }
      20%,
      94% {
        opacity: 0;
      }
      98%,
      100% {
        opacity: 1;
      }
    }
    @keyframes s-live {
      0%,
      18% {
        opacity: 0;
      }
      21%,
      66% {
        opacity: 1;
      }
      69%,
      100% {
        opacity: 0;
      }
    }
    @keyframes s-wrap {
      0%,
      67% {
        opacity: 0;
      }
      70%,
      90% {
        opacity: 1;
      }
      93%,
      100% {
        opacity: 0;
      }
    }

    .pulse::before {
      animation: ping 1.6s var(--ease-out) infinite;
    }
    .pulse::after {
      animation: ping 1.6s var(--ease-out) 0.5s infinite;
    }
    @keyframes ping {
      0% {
        opacity: 0.7;
        transform: scale(0.7);
      }
      100% {
        opacity: 0;
        transform: scale(1.5);
      }
    }

    .wave i {
      animation: bar 1s ease-in-out infinite alternate;
    }
    .wave i:nth-child(2) {
      animation-duration: 0.8s;
      animation-delay: -0.2s;
    }
    .wave i:nth-child(3) {
      animation-duration: 1.2s;
      animation-delay: -0.5s;
    }
    .wave i:nth-child(4) {
      animation-duration: 0.9s;
      animation-delay: -0.1s;
    }
    .wave i:nth-child(5) {
      animation-duration: 1.1s;
      animation-delay: -0.7s;
    }
    .wave i:nth-child(6) {
      animation-duration: 0.7s;
      animation-delay: -0.3s;
    }
    .wave i:nth-child(7) {
      animation-duration: 1.3s;
      animation-delay: -0.6s;
    }
    .wave i:nth-child(8) {
      animation-duration: 1s;
      animation-delay: -0.4s;
    }
    @keyframes bar {
      from {
        transform: scaleY(0.28);
      }
      to {
        transform: scaleY(1);
      }
    }

    .reveal {
      animation: ctx-in 14s infinite;
      animation-delay: var(--r, 0s);
    }
    .reveal.first {
      animation-name: ctx-first;
    }
    @keyframes ctx-in {
      0%,
      21% {
        opacity: 0;
        translate: 0 10px;
      }
      26%,
      90% {
        opacity: 1;
        translate: 0 0;
      }
      94%,
      100% {
        opacity: 0;
        translate: 0 0;
      }
    }
    /* the customer card pops as soon as it rings, like a real screen-pop */
    @keyframes ctx-first {
      0%,
      1% {
        opacity: 0;
        translate: 0 10px;
      }
      6%,
      90% {
        opacity: 1;
        translate: 0 0;
      }
      94%,
      100% {
        opacity: 0;
        translate: 0 0;
      }
    }

    .chip.pick {
      animation: pick 14s infinite;
    }
    @keyframes pick {
      0%,
      76% {
        border-color: var(--line-strong);
        background: var(--surface);
        color: var(--ink-2);
        box-shadow: none;
      }
      80%,
      100% {
        border-color: var(--orange);
        background: var(--orange-soft);
        color: var(--ink);
        box-shadow: 0 0 0 3px var(--orange-soft);
      }
    }

    .toast {
      animation: toast 14s infinite;
    }
    @keyframes toast {
      0%,
      80% {
        opacity: 0;
        translate: -50% 10px;
      }
      84%,
      92% {
        opacity: 1;
        translate: -50% 0;
      }
      96%,
      100% {
        opacity: 0;
        translate: -50% 4px;
      }
    }

    .stage.paused :global(*),
    .stage.paused :global(*)::before,
    .stage.paused :global(*)::after {
      animation-play-state: paused !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .wrap,
    .toast,
    .ctrls .answer {
      display: none;
    }
    .pause {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .app {
      grid-template-columns: 64px 1fr 280px;
    }
    .list {
      display: none;
    }
    .float.a {
      left: 24px;
    }
    .float.b {
      right: 24px;
    }
  }
  @media (max-width: 820px) {
    .app {
      grid-template-columns: 1fr;
      height: 460px;
    }
    .rail,
    .ctx {
      display: none;
    }
    .call {
      padding: 20px;
    }
    .status b {
      font-size: 1.25rem;
    }
    .float {
      display: none;
    }
    .stage {
      margin-top: 48px;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const button = stage?.querySelector<HTMLButtonElement>('[data-pause]');

  if (stage && button) {
    let manual = false;
    let visible = true;
    const sync = () => stage.classList.toggle('paused', manual || !visible);

    // no point animating something nobody can see
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? true;
      sync();
    }).observe(stage);

    button.addEventListener('click', () => {
      manual = !manual;
      button.setAttribute('aria-pressed', String(manual));
      button.textContent = manual ? 'Play animation' : 'Pause animation';
      sync();
    });
  }
</script>

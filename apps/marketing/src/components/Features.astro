---
// Bento grid. Tiles are different sizes on purpose, so it doesn't read as a template.
const spark = [30, 46, 38, 62, 54, 78, 66, 90, 72, 58, 64, 48];
const chart = [40, 64, 52, 82, 70, 94, 60];
---

<section class="features section" id="features">
  <div class="container">
    <header class="head reveal">
      <p class="kicker">What changes</p>
      <h2 class="h2">
        What changes when the phone <span class="soft">has a system.</span>
      </h2>
    </header>

    <div class="bento">
      <article class="tile t-phone reveal" style="--i: 0">
        <div class="copy">
          <h3>Answer with the full picture</h3>
          <p>
            The customer's name, history and open issues appear as the call rings, so agents start
            every call prepared.
          </p>
        </div>
        <div class="art phone" aria-hidden="true">
          <div class="dial">
            <span class="dot"></span>
            <div>
              <b>Grace Ishimwe</b>
              <small>Order status · 0:41</small>
            </div>
            <span class="answer">Answer</span>
          </div>
          <div class="wave">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
        </div>
      </article>

      <article class="tile t-live reveal" style="--i: 1">
        <div class="copy">
          <h3>See every queue, live</h3>
          <p>Who is waiting, for how long, and which queue is about to overflow.</p>
        </div>
        <div class="art spark" aria-hidden="true">
          {spark.map((h) => (
            <i style={`height: ${h}%`}></i>
          ))}
        </div>
      </article>

      <article class="tile t-route reveal" style="--i: 2">
        <div class="copy">
          <h3>Right call, right person</h3>
          <p>
            Route by opening hours, skill and priority, and read the whole flow before you switch it
            on.
          </p>
        </div>
        <div class="art flow" aria-hidden="true">
          <span>Hours</span>
          <em></em>
          <span>Skill</span>
          <em></em>
          <span class="on">Agent</span>
        </div>
      </article>

      <article class="tile t-rec reveal" style="--i: 3">
        <div class="copy">
          <h3>Proof, when someone asks</h3>
          <p>
            Record with consent, and settle "I called three times" with a recording and a time.
            Recordings are encrypted and playback links expire.
          </p>
        </div>
        <div class="art lock" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="5" y="11" width="14" height="9" rx="2.5"></rect>
            <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
          </svg>
        </div>
      </article>

      <article class="tile t-num reveal" style="--i: 4">
        <div class="copy">
          <h3>Numbers you can act on</h3>
          <p>
            Answer rate, wait time and handling time by hour, queue or agent. Export it when your
            boss asks.
          </p>
        </div>
        <div class="art chart" aria-hidden="true">
          {chart.map((h) => (
            <i style={`height: ${h}%`}></i>
          ))}
        </div>
      </article>

      <article class="tile t-int reveal" style="--i: 5">
        <div class="copy">
          <h3>Fits what you already use</h3>
          <p>Details from your CRM or helpdesk show up where agents already look.</p>
        </div>
        <div class="art chips" aria-hidden="true">
          <span>CRM</span>
          <span>Helpdesk</span>
          <span>Webhooks</span>
          <span>API</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .head .h2 {
    margin-top: 16px;
    max-width: 17ch;
  }
  .bento {
    margin-top: clamp(40px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 28px;
    min-height: 280px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base);
  }
  .tile:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .copy p {
    margin-top: 10px;
    max-width: 38ch;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .t-phone {
    grid-column: span 4;
    grid-row: span 2;
    min-height: 560px;
    background: var(--vanilla);
  }
  .t-live {
    grid-column: span 2;
  }
  .t-route {
    grid-column: span 2;
  }
  .t-rec {
    grid-column: span 2;
  }
  .t-num {
    grid-column: span 2;
  }
  .t-int {
    grid-column: span 2;
  }

  /* the big tile's picture */
  .phone {
    display: grid;
    gap: 24px;
    place-items: center;
  }
  .dial {
    width: min(100%, 420px);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-frame);
  }
  .dial .dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 6px var(--orange-soft);
  }
  .dial b {
    display: block;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .dial small {
    color: var(--ink-3);
    font-size: 0.8125rem;
  }
  .answer {
    margin-left: auto;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--orange);
    color: var(--orange-ink);
    font-weight: 600;
    font-size: 0.875rem;
    box-shadow: var(--shadow-cta);
  }
  .wave {
    display: flex;
    gap: 8px;
    align-items: center;
    height: 90px;
  }
  .wave i {
    width: 9px;
    border-radius: 9px;
    background: var(--orange);
  }
  .wave i:nth-child(1) {
    height: 30px;
  }
  .wave i:nth-child(2) {
    height: 56px;
  }
  .wave i:nth-child(3) {
    height: 84px;
  }
  .wave i:nth-child(4) {
    height: 70px;
  }
  .wave i:nth-child(5) {
    height: 90px;
  }
  .wave i:nth-child(6) {
    height: 48px;
  }
  .wave i:nth-child(7) {
    height: 26px;
  }

  .spark,
  .chart {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 84px;
  }
  .spark i,
  .chart i {
    flex: 1;
    border-radius: 5px 5px 2px 2px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .spark i:nth-child(8),
  .chart i:nth-child(6) {
    background: var(--orange);
  }

  .flow {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .flow span {
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .flow span.on {
    background: var(--orange-soft);
    border-color: color-mix(in srgb, var(--orange) 50%, transparent);
    color: var(--ink);
  }
  .flow em {
    flex: 1;
    min-width: 12px;
    height: 1px;
    background: var(--line-strong);
  }

  .lock {
    color: var(--ink-3);
  }
  .lock svg {
    width: 44px;
    height: 44px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips span {
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .t-phone {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 420px;
    }
    .t-live,
    .t-route,
    .t-rec,
    .t-num {
      grid-column: span 1;
    }
    .t-int {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 620px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .tile {
      padding: 22px;
      min-height: 240px;
    }
    .t-phone {
      min-height: 380px;
    }
  }
</style>

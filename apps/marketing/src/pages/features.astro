---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RouteScene from '../components/scenes/RouteScene.astro';
import ContextScene from '../components/scenes/ContextScene.astro';
import WrapScene from '../components/scenes/WrapScene.astro';
import FinalCta from '../components/FinalCta.astro';

const blocks = [
  {
    id: 'agents',
    kicker: 'For agents',
    title: 'Answer like you already know them.',
    body: 'The caller, their history and your notes sit on one screen. Answer, hold, transfer and wrap up without hunting for anything.',
    points: [
      'History and open issues show up as the call rings',
      'Hold, mute and transfer without leaving the call screen',
      'Notes and outcome saved in one step',
    ],
    scene: 'context',
  },
  {
    id: 'routing',
    kicker: 'Routing',
    title: 'Send every call to the right person.',
    body: 'Build the path a call takes: opening hours, skill, priority and overflow. You can read the whole flow before it goes live.',
    points: [
      'Opening hours and holiday schedules',
      'Skills and priority per queue',
      'Overflow and voicemail when nobody is free',
    ],
    scene: 'route',
  },
  {
    id: 'supervisors',
    kicker: 'For supervisors and managers',
    title: 'Know how the day is going, while it is going.',
    body: 'Live queues and agent status on one board. Afterwards, every call is in the history with its recording, so there is always something to check.',
    points: [
      'A live board of every queue and waiting caller',
      'Agent status at a glance: free, on a call, wrapping up',
      'Searchable call history, with recordings and outcomes',
    ],
    scene: 'wrap',
  },
];
---

<Base
  title="Features"
  description="Call history on screen, routing, live queues, recording with consent and reports. What Slide does for agents, supervisors and managers."
>
  <PageHero
    kicker="Features"
    title="Built for the whole"
    soft="phone team."
    lede="Agents, supervisors and managers each get what they need, in one place."
  />

  {blocks.map((b, i) => (
    <section class="block section" id={b.id}>
      <div class:list={['container', 'row', { flip: i % 2 === 1 }]}>
        <div class="copy reveal">
          <p class="kicker">{b.kicker}</p>
          <h2 class="h2">{b.title}</h2>
          <p class="lede">{b.body}</p>
          <ul>
            {b.points.map((p) => (
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12.5l4.5 4.5L19 7.5"></path>
                </svg>
                {p}
              </li>
            ))}
          </ul>
        </div>
        <div class="art reveal" aria-hidden="true">
          {b.scene === 'context' && <ContextScene />}
          {b.scene === 'route' && <RouteScene />}
          {b.scene === 'wrap' && <WrapScene />}
        </div>
      </div>
    </section>
  ))}

  <FinalCta />
</Base>

<style>
  .block {
    padding-block: clamp(48px, 7vw, 96px);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .flip .copy {
    order: 2;
  }
  .h2 {
    margin-top: 16px;
    font-size: var(--text-3xl);
  }
  .lede {
    margin-top: 20px;
  }
  ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  li {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--ink-2);
  }
  li svg {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--orange);
  }
  .art {
    display: grid;
    place-items: center;
    padding: clamp(24px, 4vw, 56px);
    border-radius: 28px;
    background: var(--vanilla);
    border: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }
    .flip .copy {
      order: 0;
    }
  }
</style>

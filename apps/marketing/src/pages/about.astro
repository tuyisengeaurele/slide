---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';

const principles = [
  {
    t: 'Calm over clever',
    b: 'A phone shift is stressful enough. The interface should lower the temperature, not add buttons.',
  },
  {
    t: 'Plain words',
    b: 'No jargon on the screen and none on this site. If a setting needs a paragraph to explain, we redesign the setting.',
  },
  {
    t: 'Fast, always',
    b: "Pages load quickly and clicks answer immediately. When you're on a live call, a spinner is a failure.",
  },
  {
    t: 'Honest about where we are',
    b: "Slide is early. We would rather tell you what's built and what isn't than promise the whole map.",
  },
];
---

<Base title="About" description="Why Slide exists and what we care about while building it.">
  <PageHero
    kicker="About"
    title="Call center software,"
    soft="without the noise."
    lede="Slide is being built for the people who answer the phone for a living, and for the people who run those teams."
  />

  <section class="section">
    <div class="container split">
      <div class="story reveal">
        <h2 class="h2">Why we're building it</h2>
        <p>
          Most call center tools were designed around the admin who buys them, not the agent who
          spends eight hours inside them. They're heavy, slow and full of screens nobody asked for.
        </p>
        <p>
          We think phone work can feel calmer and more human. That starts with software that loads
          fast, shows you who's calling, and gets out of the way.
        </p>
      </div>

      <ul class="principles">
        {principles.map((p, i) => (
          <li class="reveal" style={`--i: ${i}`}>
            <h3>{p.t}</h3>
            <p>{p.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCta />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .h2 {
    font-size: var(--text-3xl);
  }
  .story p {
    margin-top: 20px;
    max-width: 40ch;
    color: var(--ink-2);
    font-size: 1.0625rem;
  }
  .story .h2 {
    margin-top: 0;
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .principles li {
    padding: 24px 26px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .principles p {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>

---
interface Props {
  kicker: string;
  title: string;
  soft?: string | undefined;
  lede?: string | undefined;
}
const { kicker, title, soft, lede } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    <p class="kicker e" style="--d: 0.04s">
      {kicker}
    </p>
    <h1 class="e" style="--d: 0.1s">
      {title}
      {soft && (
        <>
          {' '}
          <span class="soft">{soft}</span>
        </>
      )}
    </h1>
    {lede && (
      <p class="lede e" style="--d: 0.2s">
        {lede}
      </p>
    )}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: clip;
    padding: clamp(64px, 9vw, 128px) 0 clamp(24px, 4vw, 48px);
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 520px;
    z-index: -1;
    background: radial-gradient(44% 60% at 50% 0%, var(--glow), transparent 72%);
  }
  h1 {
    margin-top: 16px;
    max-width: 18ch;
    font-size: var(--text-4xl);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  h1 .soft {
    color: var(--ink-3);
  }
  .lede {
    margin-top: 24px;
    max-width: 36rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .e {
      opacity: 0;
      translate: 0 18px;
      animation: rise 0.8s var(--ease-out) forwards;
      animation-delay: var(--d, 0s);
    }
    @keyframes rise {
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }
</style>

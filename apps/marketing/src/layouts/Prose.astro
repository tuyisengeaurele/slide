---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  kicker: string;
  lede?: string | undefined;
  updated?: string | undefined;
}
const { title, kicker, lede, updated } = Astro.props;
---

<Base title={title}>
  <PageHero kicker={kicker} title={title} lede={lede} />
  <article class="prose container">
    {updated && <p class="updated">Last updated {updated}</p>}
    <slot />
  </article>
</Base>

<style is:global>
  .prose {
    max-width: 46rem;
    padding-block: 24px clamp(72px, 10vw, 144px);
    color: var(--ink-2);
  }
  .prose .updated {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin-bottom: 32px;
  }
  .prose h2 {
    margin-top: 48px;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--ink);
    line-height: 1.15;
  }
  .prose h3 {
    margin-top: 28px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin-top: 14px;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }
  .prose li + li {
    margin-top: 6px;
  }
  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .prose a:hover {
    text-decoration-color: var(--orange);
  }
  .prose .draft {
    margin-top: 0;
    padding: 14px 16px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface-2);
    font-size: 0.9375rem;
  }
</style>

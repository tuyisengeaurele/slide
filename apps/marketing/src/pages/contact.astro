---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Set PUBLIC_CONTACT_EMAIL at build time and the form below sends there.
const email = import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined;
---

<Base title="Contact" description="Get in touch about Slide.">
  <PageHero
    kicker="Contact"
    title="Talk to a person,"
    soft="not a funnel."
    lede="Questions, a demo, or just curious how it would fit your team? Tell us a little and we'll write back."
  />

  <section class="section">
    <div class="container wrap">
      <form class="form reveal" data-email={email ?? ''}>
        <label>
          <span>Your name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Work email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>How can we help?</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button class="btn btn-primary" type="submit">
          Send message
        </button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="side reveal">
        <h2>Other ways</h2>
        {email ? (
          <p>
            Email <a href={`mailto:${email}`}>{email}</a>.
          </p>
        ) : (
          <p>The shared inbox opens with the launch. Until then, this form is the way in.</p>
        )}
        <p>We read everything and reply within a couple of working days.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .wrap {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  label {
    display: grid;
    gap: 8px;
  }
  label span {
    font-size: 0.875rem;
    font-weight: 550;
  }
  input,
  textarea {
    width: 100%;
    padding: 13px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--orange);
    box-shadow: 0 0 0 4px var(--orange-soft);
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  .form .btn {
    justify-self: start;
  }
  .status {
    min-height: 1.5em;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .side h2 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .side p {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .side a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-email]');
  const status = form?.querySelector<HTMLElement>('.status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const to = form.dataset.email;
    const data = new FormData(form);

    if (!to) {
      if (status)
        status.textContent =
          "Thanks. We aren't taking messages here quite yet, but we'll be set up soon.";
      return;
    }

    const subject = encodeURIComponent(`Slide enquiry from ${data.get('name')}`);
    const body = encodeURIComponent(
      `${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`,
    );
    location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    if (status) status.textContent = 'Opening your email app…';
  });
</script>
